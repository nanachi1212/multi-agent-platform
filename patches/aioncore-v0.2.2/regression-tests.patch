+//! Explicit native smoke executable. Never starts an agent or contacts a model.
+#[cfg(not(windows))]
+fn main() {
+    eprintln!("This smoke requires Windows.");
+    std::process::exit(1);
+}
+
+#[cfg(windows)]
+#[tokio::main(flavor = "current_thread")]
+async fn main() {
+    use aionui_common::CommandSpec;
+    use aionui_process::ManagedProcess;
+    use aionui_runtime::Builder;
+    use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+    use std::time::Duration;
+    use windows_sys::Win32::Foundation::FILETIME;
+    use windows_sys::Win32::System::Threading::{
+        GetProcessTimes, OpenProcess, QueryFullProcessImageNameW, PROCESS_QUERY_LIMITED_INFORMATION,
+    };
+
+    let shell = std::path::PathBuf::from(std::env::var_os("SystemRoot").unwrap())
+        .join("System32/WindowsPowerShell/v1.0/powershell.exe");
+    let process = ManagedProcess::spawn(
+        CommandSpec {
+            command: shell,
+            args: ["-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "Start-Sleep -Seconds 1; exit 42"]
+                .into_iter().map(String::from).collect(),
+            env: vec![], cwd: None,
+        }, &[],
+    ).await.expect("actual production-cfg managed spawn");
+    let raw = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, process.pid()) };
+    assert!(!raw.is_null(), "retain live shell identity");
+    let handle = unsafe { OwnedHandle::from_raw_handle(raw) };
+    let mut created: FILETIME = unsafe { core::mem::zeroed() };
+    let mut exit: FILETIME = unsafe { core::mem::zeroed() };
+    let mut kernel: FILETIME = unsafe { core::mem::zeroed() };
+    let mut user: FILETIME = unsafe { core::mem::zeroed() };
+    assert_ne!(unsafe { GetProcessTimes(handle.as_raw_handle(), &mut created, &mut exit, &mut kernel, &mut user) }, 0);
+    let mut name = [0u16; 32768]; let mut length = name.len() as u32;
+    assert_ne!(unsafe { QueryFullProcessImageNameW(raw, 0, name.as_mut_ptr(), &mut length) }, 0);
+    let status = tokio::time::timeout(Duration::from_secs(5), process.wait_for_exit())
+        .await.expect("suspended child was resumed").expect("exit status available");
+    assert_eq!(status.code(), Some(42));
+    println!("W1_MANAGED_SMOKE {}", serde_json::json!({
+        "pid":process.pid(), "created":(((created.dwHighDateTime as u64) << 32) | created.dwLowDateTime as u64).to_string(),
+        "image":String::from_utf16_lossy(&name[..length as usize]), "exitCode":status.code(), "modelRequests":0
+    }));
+    drop(process);
+    let mut ordinary = Builder::clean_cli("cmd.exe");
+    ordinary.args(["/d", "/c", "echo W1-short-ok"]);
+    let output = tokio::time::timeout(Duration::from_secs(5), ordinary.output()).await.unwrap().unwrap();
+    assert!(output.status.success());
+    assert_eq!(String::from_utf8_lossy(&output.stdout).trim(), "W1-short-ok");
+    println!("W1_ORDINARY_SMOKE PASS");
+}
