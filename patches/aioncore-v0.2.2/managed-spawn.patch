+    /// Spawn a Windows managed child without running its primary thread.
+    ///
+    /// The caller must assign containment and resume it, or kill AND reap it
+    /// on every failure. Ordinary commands deliberately keep using `spawn` /
+    /// `output`: suspending callers without a paired resume would hang them.
+    #[cfg(windows)]
+    pub fn spawn_suspended(mut self) -> io::Result<Child> {
+        const CREATE_SUSPENDED: u32 = 0x0000_0004;
+        self.inner.creation_flags(CREATE_SUSPENDED);
+        self.inner.spawn()
+    }
+
